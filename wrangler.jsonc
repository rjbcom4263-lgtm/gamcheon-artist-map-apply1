{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamcheon-artist-map-apply",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  // 플러그인은 값이 없으면 소스맵을 만들어 배포 때 함께 올립니다. 켤 때는 운영 업로드 내용이 바뀌는 것을 확인하고 켜세요.
  "upload_source_maps": false,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamcheon-artist-map-apply-db",
      "database_id": "96173dee-429c-4513-8630-8ea3f4323bd2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "gamcheon-artist-map-apply-images"
    }
  ],
  "observability": {
    "enabled": true
  }
}
