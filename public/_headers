# Cloudflare 정적 파일 응답 헤더입니다.

# 감천 골목지도(art-map 저장소에서 npm run export:site로 넣음): 공개 지도와 편집 앱은 이 사이트 안에서만 끼워 씁니다.
/map-app/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'self'

# 지도 빌드 파일은 이름에 내용 지문이 붙어 있어 오래 캐시합니다.
/map-app/assets/*
  Cache-Control: public, max-age=31536000, immutable
